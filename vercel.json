{
  "version": 2,
  "installCommand": "npm install && npm install --prefix backend",
  "buildCommand": "npm run build --prefix backend && npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/[...path].ts": { "maxDuration": 60 }
  }
}
