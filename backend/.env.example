PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:4000

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
REDIS_URL=
VAPI_API_KEY=
RABBITMQ_URL=
RABBITMQ_CALL_DISPATCH_QUEUE=call.dispatch
RABBITMQ_PREFETCH=6

# Disparo de campanhas: cada ciclo processa o quanto conseguir dentro do
# orcamento de tempo abaixo e retorna; contatos restantes ficam "pendente"
# e sao retomados pelo /api/campaigns/dispatch-cron no proximo ciclo.
CAMPAIGN_START_MAX_CONCURRENCY=6
CAMPAIGN_START_BATCH_SIZE=500
CAMPAIGN_START_PAUSE_MS=90000
CAMPAIGN_START_REQUEST_INTERVAL_MS=250
CAMPAIGN_START_MAX_RETRIES=5
CAMPAIGN_START_RETRY_BASE_MS=2000
CAMPAIGN_START_RETRY_MAX_MS=30000
CAMPAIGN_DISPATCH_TIME_BUDGET_MS=45000

# Segredo usado pelo Vercel Cron para autenticar chamadas a
# /api/campaigns/dispatch-cron (enviado como "Authorization: Bearer <valor>").
# Configure a mesma env var CRON_SECRET no projeto Vercel.
CRON_SECRET=
